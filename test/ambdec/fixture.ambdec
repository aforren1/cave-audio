# AmbDec configuration - the test fixture for tools/decoder/ambdec_to_json.py (test/ambdec/convert_test.py)
# input channel order: W Y Z X V U (chan_mask 11f = the 2H1V mixed set, ACN 0 1 2 3 4 8)

/description     ambdec_convert ctest fixture: 2H1V, two-band, n3d
/version         3
/dec/chan_mask   11f
/dec/freq_bands  2
/dec/speakers    6
/dec/coeff_scale n3d
/opt/input_scale  n3d
/opt/nfeff_comp   input
/opt/delay_comp   on
/opt/level_comp   on
/opt/xover_freq   400.000000
/opt/xover_ratio  0.000000

/speakers/{
#       id   dist   azim   elev
add_spkr S1 2.0 0 90
add_spkr S2 2.0 -90 0
add_spkr S3 2.0 0 0
add_spkr S4 2.0 0 -90
add_spkr S5 2.0 -180 0
add_spkr S6 2.0 90 0
/}

/lfmatrix/{
order_gain 1.0 1.0 1.0 0.0
add_row 1.1 1.2 1.3 1.4 1.5 1.6
add_row 2.1 2.2 2.3 2.4 2.5 2.6
add_row 3.1 3.2 3.3 3.4 3.5 3.6
add_row 4.1 4.2 4.3 4.4 4.5 4.6
add_row 5.1 5.2 5.3 5.4 5.5 5.6
add_row 6.1 6.2 6.3 6.4 6.5 6.6
/}

/hfmatrix/{
order_gain 1.0 0.5 0.25 0.0
add_row 2.2 2.4 2.6 2.8 3 3.2
add_row 4.2 4.4 4.6 4.8 5 5.2
add_row 6.2 6.4 6.6 6.8 7 7.2
add_row 8.2 8.4 8.6 8.8 9 9.2
add_row 10.2 10.4 10.6 10.8 11 11.2
add_row 12.2 12.4 12.6 12.8 13 13.2
/}

/end
