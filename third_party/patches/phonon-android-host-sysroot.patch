         cmake_args += ['-DCMAKE_FIND_LIBRARY_CUSTOM_LIB_SUFFIX=64']
         cmake_args += ['-DCMAKE_BUILD_TYPE=' + ('Debug' if debug else 'Release')]
         cmake_args += ['-DCMAKE_POSITION_INDEPENDENT_CODE=TRUE']
@@ -836,7 +849,7 @@ if args.clean is not None:
 
