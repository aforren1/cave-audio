-        cmake_args += ['-DCMAKE_MAKE_PROGRAM=' + os.path.join(ndk_path, 'prebuilt', 'windows-x86_64', 'bin', 'make.exe')]
+        cmake_args += ['-DCMAKE_MAKE_PROGRAM=' + ndk_make_program(ndk_path)]
