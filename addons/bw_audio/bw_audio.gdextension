[configuration]

entry_symbol = "bw_audio_library_init"
; Matches the extension_api.json the pinned godot-cpp compiles against (4.7.stable; see
; bindings/godot/CMakeLists.txt) - the minimum must never sit below the compiled API.
compatibility_minimum = "4.7"
reloadable = false

[libraries]

windows.editor.x86_64 = "res://addons/bw_audio/bin/bw_audio_gd.windows.editor.x86_64.dll"
; A debug export deliberately loads the RELEASE-built extension. godot-cpp's template_debug
; differs only in its own internal checks, and the Asset Store requires that every shared
; library named here actually be present — so listing a third flavour we do not build would
; be an automatic rejection, and building one would triple the godot-cpp cost to debug code
; that is not the code under debug. tools/godot/pack.ps1 parses this section and refuses to
; ship if any path below is missing, so the two cannot drift apart.
windows.template_debug.x86_64 = "res://addons/bw_audio/bin/bw_audio_gd.windows.template_release.x86_64.dll"
windows.template_release.x86_64 = "res://addons/bw_audio/bin/bw_audio_gd.windows.template_release.x86_64.dll"

; Android (arm64-v8a): what a standalone headset export loads. There is no editor flavour, because
; no Godot editor runs on the headset - the same template_release library serves a debug export,
; for the reason given above. The "lib" prefix is required: an APK extracts only lib*.so from its
; lib/<abi>/ directory.
android.template_debug.arm64 = "res://addons/bw_audio/bin/libbw_audio_gd.android.template_release.arm64.so"
android.template_release.arm64 = "res://addons/bw_audio/bin/libbw_audio_gd.android.template_release.arm64.so"

; Linux x86_64: an editor flavour (a Linux collaborator opens the project) and the release one an
; exported game loads, with template_debug pointed at it for the reason given above.
linux.editor.x86_64 = "res://addons/bw_audio/bin/libbw_audio_gd.linux.editor.x86_64.so"
linux.template_debug.x86_64 = "res://addons/bw_audio/bin/libbw_audio_gd.linux.template_release.x86_64.so"
linux.template_release.x86_64 = "res://addons/bw_audio/bin/libbw_audio_gd.linux.template_release.x86_64.so"

; macOS: ONE library per flavour, for both Apple architectures. The key carries no arch because
; Godot matches every dot-separated tag against the running platform's feature tags, and a
; universal binary has no single one to name - the FILE name still carries godot-cpp's own
; ".universal", which is the suffix its CMake builds when CMAKE_OSX_ARCHITECTURES holds both.
macos.editor = "res://addons/bw_audio/bin/libbw_audio_gd.macos.editor.universal.dylib"
macos.template_debug = "res://addons/bw_audio/bin/libbw_audio_gd.macos.template_release.universal.dylib"
macos.template_release = "res://addons/bw_audio/bin/libbw_audio_gd.macos.template_release.universal.dylib"

[dependencies]

; The OS resolves these as imports of the extension, from its own directory. Listing them
; makes the EXPORTER copy them next to the binary too — without that an exported game ships
; the extension alone and fails to load it, having worked perfectly in the editor.
;
; The engine library is the only one named, on every platform: Steam Audio is linked STATICALLY into
; it, so a with-SDK build and a no-SDK build carry the same one file.
windows.editor.x86_64 = {
  "res://addons/bw_audio/bin/bw_audio.dll": ""
}
windows.template_debug.x86_64 = {
  "res://addons/bw_audio/bin/bw_audio.dll": ""
}
windows.template_release.x86_64 = {
  "res://addons/bw_audio/bin/bw_audio.dll": ""
}

android.template_debug.arm64 = {
  "res://addons/bw_audio/bin/libbw_audio.so": ""
}
android.template_release.arm64 = {
  "res://addons/bw_audio/bin/libbw_audio.so": ""
}

; Linux keeps its engine library one directory down: it has the same file name as Android's, and
; one addon carries both. The extension finds it through an $ORIGIN run path (bindings/godot/
; CMakeLists.txt); the exporter still copies it flat beside the game binary, which the same run
; path covers.
linux.editor.x86_64 = {
  "res://addons/bw_audio/bin/linux/libbw_audio.so": ""
}
linux.template_debug.x86_64 = {
  "res://addons/bw_audio/bin/linux/libbw_audio.so": ""
}
linux.template_release.x86_64 = {
  "res://addons/bw_audio/bin/linux/libbw_audio.so": ""
}

macos.editor = {
  "res://addons/bw_audio/bin/libbw_audio.dylib": ""
}
macos.template_debug = {
  "res://addons/bw_audio/bin/libbw_audio.dylib": ""
}
macos.template_release = {
  "res://addons/bw_audio/bin/libbw_audio.dylib": ""
}
