# build output
/build/
/build*/
/out/
*.obj
*.lib
*.dll
*.pdb
*.exp
*.ilk

# IDE / tooling
.vs/
.vscode/
*.user
CMakeUserPresets.json
# Claude Code local session config (permission cache, machine-local paths)
.claude/

# vendored SDK binaries (commit headers/sources per each SDK's license; keep large
# prebuilt binaries out unless intentionally vendoring them)
/third_party/**/bin/
/third_party/**/lib/

# Steinberg ASIO SDK — fetched locally per third_party/README.md, not redistributed
# through this repo. CMake auto-detects it at third_party/asiosdk/.
/third_party/asiosdk/

# NatNet SDK — proprietary (NaturalPoint). Used only as a wire-format reference; the
# engine parses the stream off-wire and does NOT link it (GPLv3). Not redistributed here.
/third_party/NatNetSDK/

# Steam Audio prebuilt SDK — Apache-2.0 (redistributable), but the binaries are large;
# fetch the release locally per third_party/README.md. CMake auto-detects it here.
/third_party/steamaudio/

# Unity binding build artifacts (the .dll is copied into Assets/Plugins by build)
bindings/unity/**/Library/
bindings/unity/**/Temp/
bindings/unity/**/obj/

# local config / surveyed data that shouldn't be shared verbatim
*.local.json

# playground scratch (the demo generates this at startup, removes it on clean exit)
playground_src.wav
