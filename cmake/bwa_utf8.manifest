<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <!-- The process code page is UTF-8 (Windows 10 1903 and later): main's argv, getenv and every *A
       call carry UTF-8, which is what the engine's path family (os_fopen) takes. Older Windows
       ignores the element and keeps the system code page. -->
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>
</assembly>
